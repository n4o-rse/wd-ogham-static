<https://n4o-rse.github.io/wd-ogham-static/catalog>
    a dcat:Catalog ;
    dcterms:conformsTo <http://wikiba.se/ontology> ;
    dcterms:description "A static, read-only Wikibase of the Ogham stones, early medieval stones with Ogham inscriptions in Ireland, modelled in the Wikidata WikiProject OghamStones. The items come from Wikidata; every item keeps its Wikidata item as a twin." ;
    dcterms:hasPart ogscat:items,
        ogscat:properties ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:title "Ogham Stones (static Wikibase)" ;
    dcat:dataset ogscat:export,
        ogscat:wikibase-ontology ;
    dcat:landingPage <https://n4o-rse.github.io/wd-ogham-static/> .

