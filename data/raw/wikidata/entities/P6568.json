  "descriptions": {
    "be-tarask": {
      "language": "be-tarask",
      "value": "элемэнт пра асобу ці аб’ект, згаданы ў тэксьце надпісу. Толькі для выкарыстаньня ў аб’ектах пра мэдыяфайлы Вікісховішча"
    },
    "da": {
      "language": "da",
      "value": "personen eller objektet indskriften nævner"
    },
    "dag": {
      "language": "dag",
      "value": "bi ni sabi sheli zaŋ kpa daadam bee binsheli polo m pahi Wikimedia Commmons media faali nima zuɣu."
    },
    "de": {
      "language": "de",
      "value": "Personen oder Objekte, die in der Inschrift erwähnt werden. Für die zukünftige Verwendung für Wikimedia Commons."
    },
    "en": {
      "language": "en",
      "value": "item about a person or an object mentioned in the inscription's text. Use on Wikimedia Commons on media files"
    },
    "es": {
      "language": "es",
      "value": "persona u objeto mencionado en el texto de una inscripción"
    },
    "ext": {
      "language": "ext",
      "value": "pressona o ojetu mentau nel testu duna escrición"
    },
    "fi": {
      "language": "fi",
      "value": "henkilöt tai muut kohteet, joita kohteeseen lisätyissä merkinnöissä mainitaan. Käytetään Wikimedia Commonsin mediatiedostoissa"
    },
    "fr": {
      "language": "fr",
      "value": "personne ou objet mentionné dans le texte de l'inscription"
    },
